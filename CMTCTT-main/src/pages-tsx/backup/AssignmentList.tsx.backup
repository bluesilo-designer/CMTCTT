import { useState, useRef, useEffect } from "react";
import { Pagination } from "@/components/ui/Pagination";
import { assignments } from "@/data/systemHardware";
import type { Assignment, AssignmentStatus } from "@/data/systemHardware";
import { Search, ChevronDown, MoreVertical, Calendar, Eye, PackageCheck, ArrowRightToLine, CheckCircle2, X, Database } from "lucide-react";
import { SortIcon, type SortDir, nextSort, sortBy } from "@/lib/sortUtils";
import { cn } from "@/lib/utils";

const PER_PAGE = 10;

const TABS = ["Overall", "Issued", "Pending Return", "Returned", "Not Returned", "Missing"] as const;
type Tab = (typeof TABS)[number];

const TAB_STATUS_MAP: Partial<Record<Tab, AssignmentStatus>> = {
  Issued: "Issued",
  "Pending Return": "Pending Return",
  Returned: "Returned",
  "Not Returned": "Not Returned",
  Missing: "Missing",
};

/* ── Dummy booking details for the child table ─────────────────────── */
