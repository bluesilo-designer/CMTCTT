import { useState } from "react";
import { ChevronRight, ChevronDown, ChevronUp, Home, RefreshCw, AlertTriangle, CheckCircle2, HelpCircle, Cpu, Wifi, Database, Server, Activity, Thermometer } from "lucide-react";
import { cn } from "@/lib/utils";

// ── Types ─────────────────────────────────────────────────────────────────────
type Status =
  | "Passed" | "Failed"
  | "Running" | "Unknown" | "Battery Low" | "Not Found"
  | "Not Running" | "Ok" | "Jammed" | "Shutting Down" | "Low"
  | "Connected";

interface CheckItem {
  label: string;
  status: Status;
  info?: { description: string; errorMessage: string };
}

interface SectionData {
  id: string;
  title: string;
  infoTitle: string;
  overallStatus: Status;
  items: CheckItem[];
}

// ── Status helpers ─────────────────────────────────────────────────────────────
function isGood(s: Status)    { return s === "Passed" || s === "Running" || s === "Ok" || s === "Connected"; }
function isWarn(s: Status)    { return !isGood(s) && s !== "Failed"; }

function statusColor(s: Status): string {
  if (isGood(s)) return "text-green-600";
  if (s === "Failed") return "text-red-500";
  return "text-amber-500";
}

function statusBg(s: Status): string {
  if (isGood(s)) return "bg-green-50 text-green-700 border-green-200";
  if (s === "Failed") return "bg-red-50 text-red-600 border-red-200";
  return "bg-amber-50 text-amber-600 border-amber-200";
}

function statusDot(s: Status): string {
  if (isGood(s)) return "bg-green-500";
  if (s === "Failed") return "bg-red-500";
  return "bg-amber-400";
}

function StatusBadge({ status }: { status: Status }) {
  return (
    <span className={cn(
      "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold border",
      statusBg(status)
    )}>
      <span className={cn("w-1.5 h-1.5 rounded-full flex-shrink-0", statusDot(status))} />
      {status}
    </span>
  );
}

function OverallIcon({ status }: { status: Status }) {
  if (isGood(status))   return <CheckCircle2 size={16} className="text-green-500" />;
  if (status === "Failed") return <AlertTriangle size={16} className="text-red-500" />;
  return <HelpCircle size={16} className="text-amber-500" />;
}

function overallOf(items: CheckItem[]): Status {
  if (items.some((i) => i.status === "Failed")) return "Failed";
  const warn: Status[] = ["Unknown", "Battery Low", "Not Found", "Not Running", "Jammed", "Shutting Down", "Low"];
  if (items.some((i) => warn.includes(i.status))) return "Unknown";
  return "Passed";
}

